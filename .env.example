# ─── Copy to .env and fill in. Never commit .env. ───────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
APP_URL=http://localhost:5173          # SPA origin; used in invite/unsubscribe links
API_URL=http://localhost:4000

# CORS: comma-separated allow-list of browser origins
CORS_ORIGINS=http://localhost:5173

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://outreach:outreach@localhost:5432/outreach?schema=public

# Separate database for the integration test suite. Tests truncate it between runs.
TEST_DATABASE_URL=postgresql://outreach:outreach@localhost:5432/outreach_test?schema=public

# Redis (queues, distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Auth. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Field encryption for OAuth tokens / provider keys (Phase 4+).
# Must be exactly 32 bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Transactional email. Leave MAIL_TRANSPORT=console in dev: messages are logged,
# not sent, and invite links appear in the API output.
MAIL_TRANSPORT=console
MAIL_FROM="OutreachOS <no-reply@example.com>"
SMTP_URL=

# ─── Later phases (unused in Phase 1, listed so deployment config is complete) ──

# Phase 3 — Google Gemini (server-side only, never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MONTHLY_BUDGET_USD=50

# Phase 4 — mailbox OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/email/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/email/microsoft/callback

# Phase 2 — lead data providers
LEAD_PROVIDER_KEYS=

# Phase 9 — billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
